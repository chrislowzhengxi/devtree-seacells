.DS_Store

# --- ignore everything under results ...
results/**

# ...but keep directory structure so we can whitelist things
!results/**/

results/ucell/Lateral_plate_mesoderm/qc/Lateral_plate_mesoderm_obs_with_SHH_UCell_score.csv

# ...and keep EVERYTHING under any figures/ folder
!results/**/figures/**

# ...except drop exploratory/test outputs anywhere in figures
results/**/figures/**/*testp*.*
results/**/figures/*testp*.*


results/shendure_test_small/figures/
# CSV/TXT: ignore by default (you can whitelist later if needed)
*.csv
*.txt

*.h5ad

# Ignore all CSVs
*.csv

R_libs/

.RData
.Rhistory
Rplots.pdf

# But keep QC summaries or tables
!results/**/qc/*.csv
!results/**/summary*.csv
!results/**/tables/*.csv

notebooks/

# IDE
.vscode/
.idea/
results/system_qc/Lateral_plate_mesoderm/figures/umap_Lateral_plate_mesoderm_genes_umap.pdf
results/ucell/Lateral_plate_mesoderm/qc/*.csv


